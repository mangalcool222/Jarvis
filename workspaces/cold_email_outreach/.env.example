# Workspace-Specific Mailer & Sender Credentials (Optional)
# If left blank, Harvey will inherit the global .env from the project root.

# Gmail Workspace OAuth
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# Or SMTP / IMAP Provider (e.g. AgentMail, Fastmail, Zoho)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
IMAP_HOST=""
IMAP_PORT=993
IMAP_USERNAME=""
IMAP_PASSWORD=""

# Instantly (if using Instantly sequencer)
INSTANTLY_API_KEY=""
